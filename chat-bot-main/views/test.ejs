<!DOCTYPE html>
<html lang="en">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Recipe Assistant 🍳</title>

  <!-- ✅ Favicon directly from main directory -->
<link rel="icon" type="image/png" href="https://cdn-icons-png.flaticon.com/128/1830/1830839.png" />
    <style>
      * {
        box-sizing: border-box;
        font-family: "Poppins", sans-serif;
      }

      body {
        margin: 0;
        display: flex;
        height: 100vh;
        background: #ffe8cc;
        color: #333;
      }

      /* Sidebar */
      aside {
        width: 280px;
        background: #fff5ec;
        padding: 20px;
        display: flex;
        flex-direction: column;
        border-right: 2px solid #ffdebb;
      }

      aside h2 {
        text-align: center;
        margin: 0 0 20px;
        font-weight: 600;
        color: #ff7a1a;
      }

      #historyList {
        flex: 1;
        overflow-y: auto;
        padding-right: 5px;
      }

      .chat-entry {
        background: #fff;
        padding: 12px 15px;
        border-radius: 12px;
        margin-bottom: 12px;
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.06);
        cursor: pointer;
        transition: 0.3s;
        border-left: 4px solid transparent;
      }

      .chat-entry:hover {
        border-left: 4px solid #ff914d;
        background: #fff0e4;
        transform: scale(1.02);
      }

      .chat-entry strong {
        display: block;
        color: #333;
        font-size: 0.95rem;
      }

      .chat-entry small {
        color: #777;
      }

      /* Main Chat Area */
      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #ffe8cc;
        padding: 20px;
      }

      header {
        text-align: center;
        font-size: 1.6rem;
        font-weight: 600;
        background: #ff914d;
        color: #fff;
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 20px;
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.15);
      }

      #chatContainer {
        flex: 1;
        background: #fff;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
      }

      #chatBox {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        scroll-behavior: smooth;
      }

      .message {
        max-width: 75%;
        margin-bottom: 10px;
        padding: 12px 16px;
        border-radius: 16px;
        white-space: pre-wrap;
        line-height: 1.4;
        font-size: 0.95rem;
      }

      .user-message {
        background: #ffb38a;
        color: #fff;
        align-self: flex-end;
      }

      .bot-message {
        background: #e6f4ea;
        color: #333;
        align-self: flex-start;
      }

      #chatInputArea {
        display: flex;
        border-top: 1px solid #eee;
        background: #fff;
      }

      #userInput {
        flex: 1;
        border: none;
        padding: 15px;
        outline: none;
        font-size: 1rem;
      }

      #sendBtn {
        background: #ff914d;
        color: white;
        border: none;
        padding: 15px 25px;
        cursor: pointer;
        font-weight: 500;
        border-radius: 0 0 16px 0;
        transition: 0.3s;
      }

      #sendBtn:hover {
        background: #ff7a1a;
      }

      /* Empty Chat Placeholder */
      #placeholder {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #777;
        font-size: 1.1rem;
        background: #fff;
        border-radius: 16px;
        text-align: center;
      }

      /* Scrollbar */
      ::-webkit-scrollbar {
        width: 6px;
      }
      ::-webkit-scrollbar-thumb {
        background: #ffb38a;
        border-radius: 10px;
      }
    </style>
  </head>

  <body>
    <aside>
      <h2>📜 Chat History</h2>
      <div id="historyList"></div>
    </aside>

    <main>
      <header>👩‍🍳 Recipe Assistant</header>

      <div id="chatContainer">
        <div id="placeholder">🍳 Select a conversation to view it here</div>
        <div id="chatBox" style="display: none"></div>

        <div id="chatInputArea">
          <input
            type="text"
            id="userInput"
            placeholder="Ask a recipe question..."
          />
          <button id="sendBtn">Send</button>
        </div>
      </div>
    </main>

    <script>
      const chatBox = document.getElementById("chatBox");
      const placeholder = document.getElementById("placeholder");
      const input = document.getElementById("userInput");
      const sendBtn = document.getElementById("sendBtn");
      const historyList = document.getElementById("historyList");

      // chats from backend
      const chats = <%- JSON.stringify(chats) %>;

      // Render sidebar items
      function renderSidebar() {
        historyList.innerHTML = "";
        chats.forEach((chat, i) => {
          const div = document.createElement("div");
          div.className = "chat-entry";
          div.innerHTML = `
            <strong>${
              chat.userMessage.length > 50
                ? chat.userMessage.slice(0, 50) + "..."
                : chat.userMessage
            }</strong>
            <small>${new Date(chat.timestamp).toLocaleString()}</small>
          `;
          div.onclick = () => showResponse(i);
          historyList.appendChild(div);
        });
      }

      renderSidebar();

      function showResponse(index) {
        const chat = chats[index];
        placeholder.style.display = "none";
        chatBox.style.display = "flex";
        chatBox.innerHTML = `
          <div class="message user-message">${chat.userMessage}</div>
          <div class="message bot-message">${chat.botReply}</div>
        `;
      }

      async function sendMessage() {
        const userMessage = input.value.trim();
        if (!userMessage) return;

        placeholder.style.display = "none";
        chatBox.style.display = "flex";

        const userDiv = document.createElement("div");
        userDiv.className = "message user-message";
        userDiv.textContent = userMessage;
        chatBox.appendChild(userDiv);
        input.value = "";

        try {
          const res = await fetch("/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ message: userMessage }),
          });

          const data = await res.json();

          const botDiv = document.createElement("div");
          botDiv.className = "message bot-message";
          botDiv.textContent = data.reply;
          chatBox.appendChild(botDiv);
          chatBox.scrollTop = chatBox.scrollHeight;

          // ✅ Add new chat to memory and re-render sidebar instantly
          const newChat = {
            userMessage,
            botReply: data.reply,
            timestamp: new Date().toISOString(),
          };
          chats.unshift(newChat);
          renderSidebar();

        } catch (err) {
          const errDiv = document.createElement("div");
          errDiv.className = "message bot-message";
          errDiv.textContent = "⚠ Error connecting to the kitchen!";
          chatBox.appendChild(errDiv);
        }
      }

      sendBtn.addEventListener("click", sendMessage);
      input.addEventListener("keypress", (e) => {
        if (e.key === "Enter") sendMessage();
      });
    </script>
  </body>
</html>